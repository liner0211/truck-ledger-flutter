{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "TruckLedger Flutter: ios-build (flutter)",
      "type": "shell",
      "command": "flutter build ios --release --no-codesign",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "TruckLedger Flutter: Package deb (package_deb.sh)",
      "type": "shell",
      "command": "./package_deb.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "TruckLedger Flutter: Deploy to device (deploy.sh)",
      "type": "shell",
      "command": "DEVICE_PASS=${input:devicePass} ./deploy.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "TruckLedger Flutter: Debug device (debug.sh)",
      "type": "shell",
      "command": "DEVICE_PASS=${input:devicePass} ./debug.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "TruckLedger Flutter: Package ipa (package_ipa.sh)",
      "type": "shell",
      "command": "./package_ipa.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "devicePass",
      "type": "promptString",
      "description": "iPhone SSH 密码（DEVICE_PASS）",
      "password": true
    }
  ]
}

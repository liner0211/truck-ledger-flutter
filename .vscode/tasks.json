{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "一键：发版总控（push → 等 CI 编译上传部署）",
      "type": "shell",
      "command": "./scripts/with_project_env.sh ./one_click_ship.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "一键：部署 PHP 后端（rsync server-php）",
      "type": "shell",
      "command": "./scripts/with_project_env.sh ./one_click_server_deploy.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "本机：应用 Git 配置（dev/machine.env 中 GIT_*）",
      "type": "shell",
      "command": "./dev/apply_git_config.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}

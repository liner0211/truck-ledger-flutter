# =============================================================================
# 本机配置模板（复制为 dev/machine.env 后按需填写）
#   cp dev/machine.env.example dev/machine.env
# dev/machine.env 已加入 .gitignore，不会提交。
#
# 完整迁移分类清单见：docs/MIGRATION.md
# 加载：scripts/project_env.sh（其后若存在 .device.env 可覆盖）
# =============================================================================

# --- GitHub / CI（one_click_ship；私有库务必 gh auth login）---
# 留空则从 git remote origin 推断
GITHUB_REPO=
# 生产站点（健康检查 / downloads 基址）
# PUBLIC_BASE_URL=https://truck.liner0211.online

# --- Flutter（仅本地 debug / flutter run；发布包由 CI 编译）---
# 指向 flutter 可执行文件所在目录（含 flutter 与 dart），例如：
# FLUTTER_BIN_PATH=/home/you/flutter/bin
FLUTTER_BIN_PATH=

# --- Git 本仓库本地配置（可选，配置后运行: ./dev/apply_git_config.sh）---
GIT_USER_NAME=
GIT_USER_EMAIL=
# 例如: git@github.com:liner0211/truck-ledger-flutter.git
GIT_REMOTE_URL=

# --- 服务端部署（./one_click_server_deploy.sh / one_click_ship）---
# SSH 同步 server-php/（不会覆盖远端 config.php 与 data/、downloads/）
# SERVER_HOST=truck.liner0211.online
# SERVER_USER=root
# SERVER_PORT=22
# SERVER_PATH=/www/wwwroot/truck.liner0211.online
# SERVER_SSH_KEY=
# SERVER_HEALTH_URL=https://truck.liner0211.online/api/health?deep=1

# =============================================================================
# === GitHub Secrets（勿把真实密钥写进本文件；到仓库 Settings → Secrets 配置）===
# 与本机 SERVER_* / PUBLIC_BASE_URL 应对齐，便于迁服务器时对照。
# =============================================================================
# ANDROID_KEYSTORE_BASE64=   # jks 的 base64；缺则 CI 用 debug 签
# ANDROID_KEY_ALIAS=upload
# ANDROID_STORE_PASSWORD=
# ANDROID_KEY_PASSWORD=
# SERVER_SSH_KEY=            # 私钥全文（CI 部署/上传 downloads）
# SERVER_HOST=
# SERVER_USER=root
# SERVER_PORT=22
# SERVER_PATH=/www/wwwroot/<域名>
# SERVER_HEALTH_URL=https://<域名>/api/health?deep=1
# PUBLIC_BASE_URL=https://<域名>
# CI_PUBLISH_TOKEN=          # 长随机串，必须 = 远端 config.php → ci_publish_token
# FORCE_UPDATE_ON_RELEASE=     # 可选，设为 1 则发版强更
# SHIP_TEMP_PUBLIC=1          # 默认：等 CI 时临时公开仓库，结束后改回私有；设 0 关闭

# =============================================================================
# === 远端 config.php（服务器上从 config.example.php 复制；勿提交、勿被 rsync 覆盖）===
# =============================================================================
# jwt_secret=                # ≥32 随机
# ci_publish_token=          # = GitHub Secret CI_PUBLISH_TOKEN
# admin_username= / admin_password= 或 admin_password_hash=
# max_upload_bytes=          # 与 nginx client_max_body_size 一致（建议 ≥25m）
# cors_origins= / fcm_service_account_file= 等见 server-php/config.example.php
# 系统推送：把 Firebase 文件放到 dev/fcm/ 后执行 ./scripts/apply_fcm_credentials.sh
#   （详见 server-php/FCM_SETUP.md）

# --- Android 正式签名（本机 android/key.properties + keystore/，勿提交）---
# 首次：见 android/SIGNING.md；生成 jks 后把 base64/密码写入上方 GitHub Secrets
# 本机备忘（勿提交）：dev/android_signing_secrets.env

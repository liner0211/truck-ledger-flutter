# =============================================================================
# 本机配置模板（复制为 dev/machine.env 后按需填写）
#   cp dev/machine.env.example dev/machine.env
# dev/machine.env 已加入 .gitignore，不会提交。
#
# 所有脚本会通过 scripts/project_env.sh 自动加载 dev/machine.env；
# 若仍存在项目根 .device.env，也会在其后加载（旧习惯兼容，后者可覆盖）。
# =============================================================================

# --- GitHub / CI（一键拉取 Release 产物；生产 downloads 失败时回退 gh）---
# 留空则从 git remote origin 推断；私有库务必配置 gh：gh auth login
GITHUB_REPO=
# 生产站点（拉取 truckledger-latest.apk / .deb）
# PUBLIC_BASE_URL=https://truck.liner0211.online

# --- Flutter（仅本地 debug / flutter run；发布包由 CI 编译）---
# 指向 flutter 可执行文件所在目录（含 flutter 与 dart），例如：
# FLUTTER_BIN_PATH=/home/you/flutter/bin
FLUTTER_BIN_PATH=

# --- Git 本仓库本地配置（可选，配置后运行: ./dev/apply_git_config.sh）---
GIT_USER_NAME=
GIT_USER_EMAIL=
# 例如: git@github.com:liner0211/truck-ledger-flutter.git
GIT_REMOTE_URL=

# --- 越狱 iPhone SSH（一键 deb 安装、deploy.sh、debug.sh）---
DEVICE_USER=mobile
DEVICE_PASS=
SUDO_PASS=
# 不设则脚本扫描局域网；固定 IP 时可取消下行注释
# DEVICE_IP=

# --- Android adb（一键 APK 安装 / find_android_device.sh）---
# 不设则自动发现：已连接 USB 设备，或扫描局域网无线 adb（默认 5555）
# ANDROID_IP=192.168.0.128
# ANDROID_ADB_PORT=5555
# 多台设备同时连接时指定 serial（adb devices 第一列，如 192.168.0.128:5555）
# ANDROID_SERIAL=

# --- 服务端部署（./one_click_server_deploy.sh）---
# SSH 同步 server-php/ 到宝塔站点目录（不会覆盖远端 config.php 与 data/）
# SERVER_HOST=truck.liner0211.online
# SERVER_USER=root
# SERVER_PORT=22
# SERVER_PATH=/www/wwwroot/truck.liner0211.online
# SERVER_SSH_KEY=
# SERVER_HEALTH_URL=https://truck.liner0211.online/api/health?deep=1
#
# GitHub Actions 自动部署还需在仓库 Secrets 配置同上项 + CI_PUBLISH_TOKEN
# （与远端 config.php 的 ci_publish_token 一致）。说明见 docs/CI_AUTO_RELEASE.md

# --- Android 正式签名（本机 android/key.properties + keystore/，勿提交）---
# 首次：见 android/key.properties.example；生成 jks 后把 base64/密码写入 GitHub Secrets：
# ANDROID_KEYSTORE_BASE64 / ANDROID_KEY_ALIAS / ANDROID_STORE_PASSWORD / ANDROID_KEY_PASSWORD
# 本机已生成时可参考（勿提交）：dev/android_signing_secrets.env
